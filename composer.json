{
    "name": "dallol-tech/rms-backend",
    "description": "Restaurant Management System -- CodeIgniter 4 API backend (architecture v2.0)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.4",
        "firebase/php-jwt": "^6.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "codeigniter4/framework": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "lint": "vendor/bin/phpstan analyse --configuration phpstan.neon"
    },
    "config": {
    "audit": {
      "ignore": [
        "PKSA-y2cr-5h3j-g3ys"
      ]
    }
  }
}
